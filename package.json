{
  "name": "app-gastos-desktop",
  "version": "1.0.1",
  "description": "App de gastos de escritorio con auto-update en Electron.",
  "main": "electron/main.js",
  "author": "Usuario",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:publish": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.usuario.appgastos",
    "productName": "App Gastos Pro",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "files": [
      "app.js",
      "index.html",
      "style.css",
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "GRV80",
        "repo": "Finanzas",
        "releaseType": "release"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "App Gastos Pro",
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
